{
  "$schema": "https://schema.railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd faceprep && npm install && npm run build && cd ../faceprep-backend && npm install --build-from-source"
  },
  "deploy": {
    "startCommand": "node faceprep-backend/src/server.js",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30
  }
}